# APNA TOUR - Environment Configuration
# Copy this file to .env or .env.local for local development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apnatour?schema=public"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Map Provider (provider-agnostic: openstreetmap, mapbox, google, or offline-vector)
MAP_PROVIDER="openstreetmap"
MAP_API_KEY=""

# Analytics Provider (plausible, posthog, google, custom-internal)
ANALYTICS_PROVIDER="custom-internal"
ANALYTICS_ID=""

# Email Provider & Routing
# Email dispatch for travel enquiries and newsletter subscriptions
# In development without an API key, email payloads are safely logged to console.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
CONTACT_EMAIL="ashishnathtiwari12@gmail.com"
FROM_EMAIL="enquiries@apnatour.in"

# Business & DPDP Grievance Contact
GRIEVANCE_OFFICER_NAME="Ashish Nath Tiwari"
GRIEVANCE_EMAIL="ashishnathtiwari12@gmail.com"
PRIVACY_EMAIL="privacy@apnatour.in"
